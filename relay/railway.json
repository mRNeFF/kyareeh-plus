{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci --prefix relay --omit=dev",
    "watchPatterns": ["relay/**", "content/duel-engine.js", "content/duel-data.js"]
  },
  "deploy": {
    "startCommand": "node relay/server.mjs",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
