{
  "manifest_version": 3,
  "name": "Kyareeh+",
  "version": "2.6.3",
  "description": "Tableau de bord de compte, valorisation en chakra, vente, enchère et recyclage ciblé des doublons pour kyara.games.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kyara-plus@axel.dev",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://kyara.games/*",
    "https://raw.githubusercontent.com/mRNeFF/kyareeh-plus/*"
  ],
  "background": {
    "scripts": [
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://kyara.games/*"
      ],
      "js": [
        "content/ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/ui.css",
        "icons/*",
        "manifest.json",
        "duel/*",
        "content/duel-data.js",
        "content/duel-rules.js",
        "content/duel-engine.js",
        "content/duel-net.js"
      ],
      "matches": [
        "https://kyara.games/*"
      ]
    }
  ],
  "action": {
    "default_title": "Kyareeh+",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
