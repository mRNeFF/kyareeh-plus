{
  "name": "kyareeh-plus",
  "version": "2.0.1",
  "private": true,
  "description": "Extension Firefox : tableau de bord, vente assistée et analyse du marché pour kyara.games",
  "scripts": {
    "start": "web-ext run --source-dir .",
    "lint": "web-ext lint --source-dir .",
    "build": "web-ext build --source-dir . --filename kyareeh-plus-1.0.2.zip --overwrite-dest",
    "sign": "web-ext sign --source-dir . --channel unlisted --artifacts-dir web-ext-artifacts --overwrite-dest",
    "release": "node scripts/release.mjs",
    "source": "node scripts/release.mjs --build-only",
    "verify:odds": "node test/verify-odds.mjs",
    "verify:analysis": "node test/verify-analysis.mjs",
    "verify:statglobal": "node test/verify-statglobal.mjs",
    "verify:duel": "node test/verify-duel-data.mjs"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
