{
  "name": "kyareeh-plus",
  "version": "2.1.0",
  "private": true,
  "description": "Extension Firefox : tableau de bord, vente assistée et analyse du marché pour kyara.games",
  "scripts": {
    "start": "web-ext run --source-dir .",
    "lint": "web-ext lint --source-dir .",
    "build": "web-ext build --source-dir . --filename kyareeh-plus-2.1.0.zip --overwrite-dest",
    "build:chrome": "node scripts/build-chrome.mjs",
    "sign": "web-ext sign --source-dir . --channel unlisted --artifacts-dir web-ext-artifacts --overwrite-dest",
    "release": "node scripts/release.mjs",
    "source": "node scripts/release.mjs --build-only",
    "verify:odds": "node test/verify-odds.mjs",
    "verify:analysis": "node test/verify-analysis.mjs",
    "verify:autosell": "node test/verify-autosell.mjs",
    "verify:sales": "node test/verify-sales-chart.mjs",
    "verify:statglobal": "node test/verify-statglobal.mjs",
    "verify:duel": "node test/verify-duel-data.mjs",
    "verify:duel-engine": "node test/verify-duel-engine.mjs",
    "verify:duel-relay": "node test/verify-duel-relay.mjs",
    "sim:duel": "node test/sim-duel.mjs 2000",
    "relay": "node relay/server.mjs",
    "verify:chrome": "node test/chrome-smoke.mjs"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
